# PHP side of Farmedia. The PHP code reads the project-root .env (the same file the Python app uses),
# so add these keys there. Set them in the host's dashboard on production.
# Use a dedicated database user with only SELECT, INSERT, UPDATE and DELETE on the farmedia database.
# Never use the MySQL root account.

APP_ENV=development

# Sign-in needs a confirmed e-mail (users.email_verified_at). Confirmation mail is NOT sent by this
# code yet, so until it exists either set this to false, or confirm accounts by hand:
#   UPDATE users SET email_verified_at = UTC_TIMESTAMP() WHERE email = 'you@example.com';
AUTH_REQUIRE_EMAIL_CONFIRMATION=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farmedia
DB_USERNAME=farmedia_app
DB_PASSWORD=

# --- Sarp AI (Claude) ---
CLAUDE_API_KEY=
CLAUDE_API_BASE_URL=https://api.onysoft.com/v1
CLAUDE_MODEL=claude-sonnet-5-5
