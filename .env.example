# Copy to .env (local) or set these in your host's dashboard (production). Never commit .env.

# --- Runtime ---
# "production" turns off the API docs pages and adds HSTS. Anything else is development.
APP_ENV=development
# Port the server listens on. Hosting platforms usually set this themselves.
PORT=8000
# Proxies whose X-Forwarded-* headers are trusted (comma-separated IPs). Set this to your
# load balancer's address when the app runs behind one, e.g. 10.0.0.5.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Sarp AI (Claude, called from PHP: php/src/SarpAi.php) ---
# Without a key, Sarp AI answers "not configured". Keep the key out of git.
CLAUDE_API_KEY=
# Gateway base URL. Must be HTTPS. Change only if your gateway differs.
CLAUDE_API_BASE_URL=https://api.onysoft.com/v1
CLAUDE_MODEL=claude-sonnet-5-5

# The PHP settings (database, sign-in) are in php/.env.example and read from this same file.
