# Copy to .env (local) or set these in your host's dashboard (production). Never commit .env.

# --- Runtime ---
# "production" turns off the API docs pages and adds HSTS. Anything else is development.
APP_ENV=development
# Port the server listens on. Hosting platforms usually set this themselves.
PORT=8000
# Proxies whose X-Forwarded-* headers are trusted (comma-separated IPs). Set this to your
# load balancer's address when the app runs behind one, e.g. 10.0.0.5.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Sarp AI (Groq, OpenAI-compatible API) ---
# Get a key at https://console.groq.com. Without it, Sarp AI answers "not configured".
GROQ_API_KEY=

# --- Supabase (auth + database). Find both in: Project Settings > API. ---
# Use only the PUBLIC anon key here. The service_role key must never be set in this app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
